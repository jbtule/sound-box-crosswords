// The sync service's Cloudflare Worker (see src/index.js). Deployed by the sync-deploy
// job in .github/workflows/ci.yml with `wrangler deploy` from this folder.
{
  "name": "sound-box-sync",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  // Only at its own address, not on workers.dev.
  "workers_dev": false,
  "routes": [{ "pattern": "sound-box-sync.asset-data.stream", "custom_domain": true }],
  // SQLite Durable Objects (free plan): one per profile, one per counter of new profiles a day,
  // and one counting everyone's room.
  "durable_objects": { "bindings": [
    { "name": "PROFILE", "class_name": "Profile" },
    { "name": "LIMITER", "class_name": "Limiter" },
    { "name": "SPACE", "class_name": "Space" }
  ] },
  // Requests per network a minute (api.js NET_LIMIT): a nuisance guard against scripts, not a
  // security boundary. Approximate and counted per Cloudflare location.
  "ratelimits": [{ "name": "NET_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Profile"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] },
    { "tag": "v3", "new_sqlite_classes": ["Space"] }
  ]
}
